{
  "name": "@fair-fx/core",
  "version": "0.0.1",
  "description": "Pairs, fixed point math, formatting and freshness. Main entry has no I/O; /node holds the Node-only readers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fair-fx/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@fair-fx/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./testing": {
      "@fair-fx/source": "./src/testing/index.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.4.0",
    "zod": "4.6.7"
  }
}
