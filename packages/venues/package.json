{
  "name": "@fair-fx/venues",
  "version": "0.0.1",
  "description": "One quote adapter per venue, behind VenueAdapter.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fair-fx/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@fair-fx/source": "./src/testing/index.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fair-fx/core": "workspace:*",
    "@stellar/stellar-sdk": "17.4.0",
    "zod": "4.6.7"
  }
}
