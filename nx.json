{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "sharedTs": ["{workspaceRoot}/tsconfig.base.json"],
    "sharedLint": ["{workspaceRoot}/eslint.config.mjs"]
  },
  "targetDefaults": {
    "lint": { "cache": true, "inputs": ["default", "sharedLint", "^default"] },
    "typecheck": { "cache": true, "inputs": ["default", "sharedTs", "^default"] },
    "test": { "cache": true, "inputs": ["default", "sharedTs", "^default"] }
  }
}
