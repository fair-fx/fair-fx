{
  "name": "fairfx",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r run typecheck",
