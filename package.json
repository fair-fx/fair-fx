    "check": "pnpm audit --audit-level high && pnpm lint && pnpm typecheck && pnpm test && pnpm deps"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/eslint-plugin": "24.0.6",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "nx": "24.0.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
